<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>Pixel Coin Quest</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  :root{--bg:#10101c;--fg:#f4f4f4;--accent:#ffd23f}
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;touch-action:manipulation}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font-family:'Press Start 2P',monospace}
  body{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:8px}
  #hud{display:flex;justify-content:space-between;width:min(96vw,640px);font-size:10px}
  #wrap{position:relative;width:min(96vw,640px);aspect-ratio:192/112}
  canvas{width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;border:4px solid #3a3a5c;border-radius:4px;background:#000}
  #msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:12px;font-size:11px;line-height:1.6;background:rgba(8,8,20,.72)}
  #msg h1{font-size:clamp(14px,4vw,24px);color:var(--accent);margin:0}
  #msg.hide{display:none}
  #pad{display:flex;justify-content:space-between;width:min(96vw,640px);gap:10px}
  #pad div{display:flex;gap:10px}
  .b{width:72px;height:72px;border:4px solid #3a3a5c;background:#1d1d33;color:var(--fg);font:inherit;font-size:20px;border-radius:8px;display:flex;align-items:center;justify-content:center}
  .b.on{background:var(--accent);color:#000}
  @media (hover:hover) and (pointer:fine){#pad{display:none}}
</style>
</head>
<body>
<div id="hud"><span id="s">SKOR 0</span><span id="l">LEVEL 1</span><span id="v">NYAWA 3</span></div>
<div id="wrap">
  <canvas id="c" width="192" height="112"></canvas>
  <div id="msg"><h1>PIXEL COIN QUEST</h1><div>Kumpulkan semua koin!<br>Injak musuh, hindari duri.</div><div id="go">TEKAN SPASI / SENTUH UNTUK MULAI</div></div>
</div>
<div id="pad">
  <div><button class="b" id="bl">◀</button><button class="b" id="br">▶</button></div>
  <button class="b" id="bj">▲</button>
</div>

<script>
(()=>{
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
const T=8,COLS=24,ROWS=14;
const levels=[
 [ "........................",
   "........................",
   "........................",
   "..o..................o..",
   "..###..............###..",
   "........................",
   "......o..........o......",
   ".....####......####.....",
   "........................",
   "..o..........E.......o..",
   "..####....#######..####.",
   ".P......................",
   "########################",
   "########################" ],
 [ "........................",
   "........................",
   "...o................o...",
   "..###..............###..",
   "........................",
   ".......o........o.......",
   "......###......###......",
   "........................",
   "....o...E......E....o...",
   "...####.######.####.###.",
   "........................",
   ".P.........^^...........",
   "#####..#########..######",
   "#####..#########..######" ],
 [ "........................",
   "o......................o",
   "##....o..........o....##",
   "......###......###......",
   "........................",
   "...o..............o.....",
   "..###....o....o...###...",
   ".........####...........",
   "......E...........E.....",
   "..#######..^^^..#######.",
   "........................",
   ".P..o.....E.......o.....",
   "####..####..######..####",
   "####..####..######..####" ]
];
let lvl=0,map,coins,enemies,start,p,score=0,lives=3,state='title',tick=0;
const keys={};
const $=id=>document.getElementById(id);

function load(n){
  map=levels[n].map(r=>r.padEnd(COLS,'.').slice(0,COLS).split(''));
  coins=[];enemies=[];
  for(let y=0;y<ROWS;y++)for(let x=0;x<COLS;x++){
    const c=map[y][x];
    if(c==='o'){coins.push({x:x*T+4,y:y*T+4});map[y][x]='.';}
    else if(c==='E'){enemies.push({x:x*T,y:y*T+1,w:7,h:7,dir:1,alive:true});map[y][x]='.';}
    else if(c==='P'){start={x:x*T+1,y:y*T};map[y][x]='.';}
  }
  respawn();hud();
}
function respawn(){p={x:start.x,y:start.y,w:6,h:7,vx:0,vy:0,ground:false,face:1,coyote:0};}
function hud(){$('s').textContent='SKOR '+score;$('l').textContent='LEVEL '+(lvl+1);$('v').textContent='NYAWA '+lives;}

function solid(px,py){
  const tx=Math.floor(px/T),ty=Math.floor(py/T);
  if(tx<0||tx>=COLS)return true;
  if(ty<0||ty>=ROWS)return false;
  return map[ty][tx]==='#';
}
function hits(x,y,w,h){return solid(x,y)||solid(x+w-.01,y)||solid(x,y+h-.01)||solid(x+w-.01,y+h-.01);}
function spike(x,y,w,h){
  for(const [a,b] of [[x,y],[x+w-.01,y],[x,y+h-.01],[x+w-.01,y+h-.01]]){
    const tx=Math.floor(a/T),ty=Math.floor(b/T);
    if(ty>=0&&ty<ROWS&&tx>=0&&tx<COLS&&map[ty][tx]==='^'&&b%T>3)return true;
  }
  return false;
}

// audio
let ac;
function beep(f,d=.08,type='square',v=.04){
  try{
    ac=ac||new (window.AudioContext||window.webkitAudioContext)();
    const o=ac.createOscillator(),g=ac.createGain();
    o.type=type;o.frequency.value=f;g.gain.value=v;
    o.connect(g);g.connect(ac.destination);
    g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+d);
    o.start();o.stop(ac.currentTime+d);
  }catch(e){}
}

function die(){
  beep(120,.3,'sawtooth');
  lives--;hud();
  if(lives<=0){state='over';show('GAME OVER','SKOR: '+score+'<br>TEKAN SPASI / SENTUH UNTUK ULANG');}
  else respawn();
}
function show(h,t){const m=$('msg');m.querySelector('h1').textContent=h;m.querySelector('div').innerHTML=t;$('go').textContent='';m.classList.remove('hide');}
function hide(){$('msg').classList.add('hide');}

function update(){
  tick++;
  if(state!=='play')return;
  const L=keys.left,R=keys.right;
  const acc=.25,max=1.5;
  if(L)p.vx=Math.max(p.vx-acc,-max),p.face=-1;
  else if(R)p.vx=Math.min(p.vx+acc,max),p.face=1;
  else p.vx*=.7;
  if(Math.abs(p.vx)<.05)p.vx=0;
  p.vy=Math.min(p.vy+.15,3);
  p.coyote=p.ground?6:p.coyote-1;
  if(keys.jump&&p.coyote>0){p.vy=-2.9;p.ground=false;p.coyote=0;keys.jump=false;beep(520,.1);}
  // x
  p.x+=p.vx;
  if(hits(p.x,p.y,p.w,p.h)){p.x-=p.vx;p.vx=0;}
  // y
  p.y+=p.vy;p.ground=false;
  if(hits(p.x,p.y,p.w,p.h)){
    if(p.vy>0)p.ground=true;
    p.y-=p.vy;
    // snap
    const step=p.vy>0?.1:-.1;
    while(!hits(p.x,p.y+step,p.w,p.h))p.y+=step;
    p.vy=0;
  }
  if(p.y>ROWS*T+8)die();
  if(spike(p.x,p.y,p.w,p.h))die();
  // coins
  for(let i=coins.length-1;i>=0;i--){
    const c=coins[i];
    if(Math.abs(p.x+3-c.x)<6&&Math.abs(p.y+3.5-c.y)<6){
      coins.splice(i,1);score+=10;hud();beep(880,.08);beep(1320,.1);
    }
  }
  // enemies
  for(const e of enemies){
    if(!e.alive)continue;
    e.x+=e.dir*.4;
    const fx=e.dir>0?e.x+e.w+.5:e.x-.5;
    if(solid(fx,e.y+e.h/2)||!solid(fx,e.y+e.h+1))e.dir*=-1;
    if(p.x<e.x+e.w&&p.x+p.w>e.x&&p.y<e.y+e.h&&p.y+p.h>e.y){
      if(p.vy>0&&p.y+p.h-p.vy<=e.y+3){
        e.alive=false;p.vy=-2;score+=50;hud();beep(300,.12);
      }else{die();return;}
    }
  }
  // level clear
  if(coins.length===0){
    lvl++;
    if(lvl>=levels.length){
      state='win';
      show('KAMU MENANG!','SKOR AKHIR: '+score+'<br>TEKAN SPASI / SENTUH UNTUK MAIN LAGI');
      beep(660,.15);setTimeout(()=>beep(880,.15),150);setTimeout(()=>beep(1320,.3),300);
    }else{load(lvl);beep(700,.2);}
  }
}

// drawing helpers
function spr(rows,pal,x,y,flip){
  for(let j=0;j<rows.length;j++)for(let i=0;i<rows[j].length;i++){
    const ch=rows[j][flip?rows[j].length-1-i:i];
    if(ch==='.')continue;
    ctx.fillStyle=pal[ch];ctx.fillRect(Math.round(x)+i,Math.round(y)+j,1,1);
  }
}
const PLAYER=[
 ".rrrr.",
 "rrrrrr",
 ".ssss.",
 ".sksk.",
 ".bbbb.",
 ".b..b.",
 ".dd.dd"];
const PPAL={r:'#e63946',s:'#ffcba4',k:'#111',b:'#3a86ff',d:'#5a3825'};
const ENEMY=[
 ".gggg..",
 "gggggg.",
 "gwkgwkg",
 "ggggggg",
 "ggggggg",
 ".g...g."];
const EPAL={g:'#7bd389',w:'#fff',k:'#111'};

function draw(){
  // sky
  const g=ctx.createLinearGradient(0,0,0,112);
  g.addColorStop(0,'#1b1f4a');g.addColorStop(1,'#5b3a8c');
  ctx.fillStyle=g;ctx.fillRect(0,0,192,112);
  ctx.fillStyle='#fff';
  for(let i=0;i<24;i++){
    const sx=(i*53)%192,sy=(i*29)%60;
    if((i+Math.floor(tick/30))%5)ctx.fillRect(sx,sy,1,1);
  }
  // tiles
  for(let y=0;y<ROWS;y++)for(let x=0;x<COLS;x++){
    const c=map[y][x];
    if(c==='#'){
      const top=!(y>0&&map[y-1][x]==='#');
      ctx.fillStyle='#6b4423';ctx.fillRect(x*T,y*T,T,T);
      ctx.fillStyle='#8a5a2e';ctx.fillRect(x*T+1,y*T+3,2,2);ctx.fillRect(x*T+5,y*T+6,2,1);
      if(top){ctx.fillStyle='#4caf50';ctx.fillRect(x*T,y*T,T,3);ctx.fillStyle='#81c784';ctx.fillRect(x*T,y*T,T,1);}
    }else if(c==='^'){
      ctx.fillStyle='#cfd8dc';
      for(let k=0;k<2;k++){
        ctx.fillRect(x*T+k*4+1,y*T+4,2,4);ctx.fillRect(x*T+k*4+1.5,y*T+3,1,1);ctx.fillRect(x*T+k*4,y*T+6,4,2);
      }
    }
  }
  // coins
  for(const c of coins){
    const w=Math.abs(Math.sin((tick+c.x*3)/10))*3+1;
    ctx.fillStyle='#ffd23f';ctx.fillRect(Math.round(c.x-w/2),c.y-3,Math.round(w),6);
    ctx.fillStyle='#fff3a0';ctx.fillRect(Math.round(c.x-w/2),c.y-3,1,6);
  }
  // enemies
  for(const e of enemies)if(e.alive)spr(ENEMY,EPAL,e.x,e.y-0,e.dir<0);
  // player
  if(state!=='over')spr(PLAYER,PPAL,p.x,p.y,p.face<0);
}

function loop(){update();draw();requestAnimationFrame(loop);}

function begin(){
  if(state==='play')return;
  score=0;lives=3;lvl=0;load(0);state='play';hide();
  try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();ac.resume();}catch(e){}
}

// input
const map_={ArrowLeft:'left',a:'left',A:'left',ArrowRight:'right',d:'right',D:'right'};
addEventListener('keydown',e=>{
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();
  if(state!=='play'&&(e.key===' '||e.key==='Enter')){begin();return;}
  if(map_[e.key])keys[map_[e.key]]=true;
  if(e.key===' '||e.key==='ArrowUp'||e.key==='w'||e.key==='W')keys.jump=true;
});
addEventListener('keyup',e=>{
  if(map_[e.key])keys[map_[e.key]]=false;
  if(e.key===' '||e.key==='ArrowUp'||e.key==='w'||e.key==='W')keys.jump=false;
});
function hold(id,k){
  const el=$(id);
  const on=e=>{e.preventDefault();keys[k]=true;el.classList.add('on');if(state!=='play')begin();};
  const off=e=>{e.preventDefault();keys[k]=false;el.classList.remove('on');};
  el.addEventListener('pointerdown',on);
  ['pointerup','pointerleave','pointercancel'].forEach(ev=>el.addEventListener(ev,off));
}
hold('bl','left');hold('br','right');hold('bj','jump');
$('msg').addEventListener('pointerdown',begin);

load(0);
state='title';
loop();
})();
</script>
</body>
</html>
